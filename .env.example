# Optional AI synthesis/scoring. Keep the real value in the hosting provider's secret store.
OPENAI_API_KEY=

# Public Solana mainnet addresses. Leave blank before audited deployment.
MUSE_TOKEN_ADDRESS=
MUSE_TREASURY_ADDRESS=
MUSE_REWARD_TOKEN_ACCOUNT=
MUSE_REWARD_MINT=Xsa62P5mvPszXL1krVUnU5ar38bBSVcWAB6fmPCo5Zu
MUSE_REWARD_DECIMALS=8
MUSE_REWARD_PROGRAM_ID=
# Public address authorized to commit each deterministic epoch root.
MUSE_KEEPER_ADDRESS=
# Legacy alias retained for older deployments.
MUSE_OPERATOR_ADDRESS=
# Owner's ChatGPT email. Configure as a server secret, never in client code.
MUSE_OPERATOR_EMAIL=
# Optional service credential (32+ characters) for the off-site keeper only.
# This credential cannot open the operator console or restart a round.
MUSE_KEEPER_API_KEY=

# RPC URL may be public or provider-specific. Do not put credentials in source control.
MUSE_CHAIN_RPC_URL=https://api.mainnet-beta.solana.com

# The public website never needs a wallet seed or raw signing key. The keeper
# signs from a separate automation service or hardware-backed secret store.
